# Exclude development, test, and documentation folders
prune .github
prune .tx
prune docs
prune locale
prune scripts
prune test_utils
exclude src/edx_toggles/conf/locale/config.yaml

# Exclude root level configuration and build files
exclude .annotation_safe_list.yml
exclude .gitignore
exclude .pii_annotations.yml
exclude .readthedocs.yaml
exclude Makefile
exclude catalog-info.yaml
exclude codecov.yml
exclude manage.py
exclude openedx.yaml
exclude pylintrc
exclude pylintrc_tweaks
exclude test_settings.py
exclude tox.ini

# Exclude test/coverage artifacts
prune htmlcov
global-exclude .coverage
global-exclude coverage.xml

# Exclude dev/CI lockfile (pip never reads it during sdist install)
exclude uv.lock
